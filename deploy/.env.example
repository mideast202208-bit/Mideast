# Copy to deploy/.env ON YOUR SERVER. Never commit production secrets.
PUBLIC_ORIGIN=https://crm.YOUR-DOMAIN.example
CRM_DOMAIN=crm.YOUR-DOMAIN.example
ACME_EMAIL=owner@YOUR-DOMAIN.example
# Cloud API integration stays disabled until configured. Use a supported Graph version.
META_GRAPH_VERSION=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_INTAKE_USER_ID=
META_WABA_ID=
# Backups are local to the server; arrange encrypted offsite copies separately.
BACKUP_INTERVAL_HOURS=24
BACKUP_DIR=/app/backups
# Configure BEFORE enabling the new encrypted production backup service.
BACKUP_SOURCE_ROOT=/app
PERSISTENT_DATA_DIR=/app/data
REQUIRE_PERSISTENT_STORAGE=1
BACKUP_REQUIRE_ENCRYPTED=1
# Public RSA 3072+ recipient key. Keep the encrypted private key OFF Render/GitHub.
BACKUP_PUBLIC_KEY=
# Dedicated 32+ random character export credential; leave empty to disable machine export.
BACKUP_EXPORT_TOKEN=
# Set only for a separate restore drill; prevents worker and direct integration network calls.
RECOVERY_MODE=0
# Optional exact HTTPS origins ONLY after DNS/TLS verification and owner approval.
# Example transition value: https://crm.mideastedu-eg.com
ADDITIONAL_ORIGINS=
